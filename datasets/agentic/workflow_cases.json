      "steps_executed": 1,
      "successful_steps": 0,
      "failed_steps": 1,
      "execution_order": [
        "approve_expense_claim"
      ],
      "first_error_type": "PermissionError"
    }
  },
  {
    "case_id": "WF-005",
    "description": "Allow administrator to approve an expense",
    "role": "admin",
    "stop_on_failure": true,
    "steps": [
